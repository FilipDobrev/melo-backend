NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/melo?schema=public
# Used only by `npm run test:integration`. Must point at a separate database
# on the same server - the integration suite truncates every table between
# tests, so it must never point at your development database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/melo_test?schema=public
JWT_ACCESS_SECRET=change-me-please-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
CORS_ORIGINS=*
S3_BUCKET=melo-images
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
API_PUBLIC_BASE_URL=http://localhost:4000
