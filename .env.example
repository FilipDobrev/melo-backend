NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/melo?schema=public
# Used only by `npm run test:integration`. Must point at a separate database
# on the same server - the integration suite truncates every table between
# tests, so it must never point at your development database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/melo_test?schema=public
JWT_ACCESS_SECRET=change-me-please-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Days a soft-deleted account stays recoverable before purge-deleted-users can purge it.
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30
BCRYPT_ROUNDS=12
# "*" is fine for local dev (no meaningful origin to restrict), but the app
# refuses to boot with NODE_ENV=production and this left at "*" - shipping a
# wildcard to production by forgetting to set this would otherwise be a
# silent misconfiguration, not a loud one. Set to a comma-separated list of
# allowed origins before deploying.
CORS_ORIGINS=*
# Number of reverse proxies in front of this process (or a comma-separated
# list of trusted proxy IPs/CIDRs). Controls Express's `trust proxy`, which
# every rate limiter keys off of via req.ip. Leave at 0 for local dev, where
# requests hit the app directly. For a typical single-proxy PaaS deployment
# (Render, Koyeb, Fly) or a single nginx/Caddy box in front of the app, set
# this to 1. Setting it too high (or to "true"/trust-everything) lets a
# client forge X-Forwarded-For and pick their own rate-limit bucket; too low
# (leaving it at 0 in production) collapses every client onto one bucket.
TRUST_PROXY=0
S3_BUCKET=melo-images
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Per-account login lockout, on top of the per-IP limiter above - see
# src/services/loginLockout.service.ts. Consecutive failed logins allowed
# against one account before it is locked out, and how long the lockout lasts.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_DURATION_MINUTES=15
# Backstop across the whole API, requests allowed per IP per window.
GENERAL_RATE_LIMIT_MAX=300
GENERAL_RATE_LIMIT_WINDOW_MINUTES=1
# Presigned upload URL requests allowed per IP per window (tighter than the general limit).
UPLOAD_URL_RATE_LIMIT_MAX=10
UPLOAD_URL_RATE_LIMIT_WINDOW_MINUTES=5
API_PUBLIC_BASE_URL=http://localhost:4000
